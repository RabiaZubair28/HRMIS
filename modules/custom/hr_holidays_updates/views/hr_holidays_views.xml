<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_hr_leave_form_my_inherit" model="ir.ui.view">
        <field name="name">hr.leave.form.my.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <!-- FIX: Add domain to the ORIGINAL leave type field -->
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="domain">
                    "[('allowed_gender', '=', 'all')]"
                </attribute>
            </xpath>

            <!-- Add custom tab -->
            <xpath expr="//notebook" position="inside">
                <page name="my_leave_info" string="My Leave Info">
                    <group>
                        <group string="My Information">
                            <field name="employee_id" options="{'no_open': True}"/>
                            <field name="my_leave_reference"/>
                            <field name="my_approval_officer"/>
                            <field name="my_leave_category"/>
                        </group>

                        <group string="Additional Info">
                            <field name="my_remarks" widget="textarea"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- TREE VIEW (NO DOMAIN HERE!) -->
    <record id="view_hr_leave_hist_my_inherit" model="ir.ui.view">
        <field name="name">hr.leave.hist.my.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_hist"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="allowed_gender"/>
            </xpath>
        </field>
    </record>
</odoo>
